{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://az-permit-radar.local/schemas/autonomous-roadmap.schema.json",
  "title": "AZ Permit Radar Autonomous Roadmap",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "validationCommand": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 7200
        }
      },
      "required": [
        "name",
        "argv",
        "timeout_seconds"
      ]
    },
    "approvalGate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "required_before_run": {
          "type": "boolean"
        },
        "approval_files": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "required_before_run",
        "approval_files"
      ]
    },
    "commitPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "required": {
          "type": "boolean"
        },
        "allowed_outcomes": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "COMPLETED",
              "PASS",
              "PASS_WITH_REQUIRED_CORRECTIONS",
              "BLOCKED",
              "APPROVAL_REQUIRED",
              "FAILED"
            ]
          }
        },
        "message_template": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "required",
        "allowed_outcomes",
        "message_template"
      ]
    },
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^\\d{3}$"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "stage_group": {
          "type": "string",
          "minLength": 1
        },
        "prompt_file": {
          "type": "string",
          "pattern": "^automation/numbered/.+\\.md$"
        },
        "effort_label": {
          "type": "string",
          "enum": [
            "Light",
            "Medium",
            "High",
            "Extra High",
            "Ultra"
          ]
        },
        "reasoning_effort": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high",
            "xhigh"
          ]
        },
        "kind": {
          "type": "string",
          "enum": [
            "implementation",
            "documentation",
            "decision_gate",
            "audit",
            "release_gate"
          ]
        },
        "sandbox": {
          "type": "string",
          "enum": [
            "read-only",
            "workspace-write"
          ]
        },
        "branch_slug": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "prerequisites": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^\\d{3}$"
          }
        },
        "audit_gate": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "none",
                "latest_formal"
              ]
            },
            "allowed_outcomes": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "PASS",
                  "PASS_WITH_REQUIRED_CORRECTIONS",
                  "BLOCKED"
                ]
              }
            }
          },
          "required": [
            "mode",
            "allowed_outcomes"
          ]
        },
        "human_approval": {
          "$ref": "#/$defs/approvalGate"
        },
        "context_files": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "allowed_change_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "forbidden_change_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "validation": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "commands": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/validationCommand"
              }
            }
          },
          "required": [
            "commands"
          ]
        },
        "commit": {
          "$ref": "#/$defs/commitPolicy"
        },
        "audit": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "formal": {
              "type": "boolean"
            },
            "report_slug": {
              "type": "string"
            }
          },
          "required": [
            "formal",
            "report_slug"
          ]
        },
        "codex_timeout_seconds": {
          "type": "integer",
          "minimum": 60,
          "maximum": 14400
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "id",
        "sequence",
        "title",
        "stage_group",
        "prompt_file",
        "effort_label",
        "reasoning_effort",
        "kind",
        "sandbox",
        "branch_slug",
        "prerequisites",
        "audit_gate",
        "human_approval",
        "context_files",
        "allowed_change_paths",
        "forbidden_change_paths",
        "validation",
        "commit",
        "audit",
        "codex_timeout_seconds",
        "notes"
      ]
    },
    "appendix": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "appendix_id": {
          "type": "string",
          "enum": [
            "A",
            "B",
            "C"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "prompt_file": {
          "type": "string",
          "pattern": "^automation/appendices/.+\\.md$"
        },
        "effort_label": {
          "type": "string",
          "enum": [
            "Light",
            "Medium",
            "High",
            "Extra High",
            "Ultra"
          ]
        },
        "reasoning_effort": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high",
            "xhigh"
          ]
        },
        "kind": {
          "type": "string",
          "enum": [
            "implementation",
            "audit",
            "release_gate"
          ]
        },
        "sandbox": {
          "type": "string",
          "enum": [
            "read-only",
            "workspace-write"
          ]
        },
        "normal_execution_eligible": {
          "type": "boolean"
        },
        "requires_explicit_invocation": {
          "type": "boolean"
        },
        "human_approval": {
          "$ref": "#/$defs/approvalGate"
        },
        "hard_lock": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled_by_default": {
              "type": "boolean"
            },
            "confirmation_phrase": {
              "type": "string"
            }
          },
          "required": [
            "enabled_by_default",
            "confirmation_phrase"
          ]
        },
        "context_files": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "allowed_change_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "forbidden_change_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "validation": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "commands": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/validationCommand"
              }
            }
          },
          "required": [
            "commands"
          ]
        },
        "commit": {
          "$ref": "#/$defs/commitPolicy"
        },
        "codex_timeout_seconds": {
          "type": "integer",
          "minimum": 60,
          "maximum": 14400
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "appendix_id",
        "title",
        "prompt_file",
        "effort_label",
        "reasoning_effort",
        "kind",
        "sandbox",
        "normal_execution_eligible",
        "requires_explicit_invocation",
        "human_approval",
        "hard_lock",
        "context_files",
        "allowed_change_paths",
        "forbidden_change_paths",
        "validation",
        "commit",
        "codex_timeout_seconds",
        "notes"
      ]
    }
  },
  "properties": {
    "format_version": {
      "const": "1.0",
      "type": "string"
    },
    "roadmap_version": {
      "type": "string",
      "minLength": 1
    },
    "project_name": {
      "const": "AZ Permit Radar",
      "type": "string"
    },
    "repository_root_name": {
      "const": "AZPR",
      "type": "string"
    },
    "base_branch": {
      "type": "string",
      "minLength": 1
    },
    "generated_from": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "prompt_manifest": {
          "type": "string"
        },
        "prompt_count": {
          "type": "integer",
          "minimum": 1
        },
        "generated_at": {
          "type": "string"
        },
        "generator_prompt": {
          "type": "string"
        }
      },
      "required": [
        "prompt_manifest",
        "prompt_count",
        "generated_at",
        "generator_prompt"
      ]
    },
    "normal_execution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maximum_stages_per_run": {
          "const": 1,
          "type": "integer"
        },
        "include_appendix_a": {
          "type": "boolean"
        },
        "include_appendix_b": {
          "const": false,
          "type": "boolean"
        },
        "include_appendix_c": {
          "const": false,
          "type": "boolean"
        }
      },
      "required": [
        "maximum_stages_per_run",
        "include_appendix_a",
        "include_appendix_b",
        "include_appendix_c"
      ]
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/stage"
      }
    },
    "appendices": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "A": {
          "$ref": "#/$defs/appendix"
        },
        "B": {
          "$ref": "#/$defs/appendix"
        },
        "C": {
          "$ref": "#/$defs/appendix"
        }
      },
      "required": [
        "A",
        "B",
        "C"
      ]
    }
  },
  "required": [
    "format_version",
    "roadmap_version",
    "project_name",
    "repository_root_name",
    "base_branch",
    "generated_from",
    "normal_execution",
    "stages",
    "appendices"
  ]
}
