{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://az-permit-radar.local/schemas/execution-records-v1.schema.json",
  "title": "AZPR separate execution run, evidence, and outcome records",
  "oneOf": [
    {"$ref": "#/$defs/run"},
    {"$ref": "#/$defs/evidence"},
    {"$ref": "#/$defs/outcome"}
  ],
  "$defs": {
    "identity": {
      "type": "object",
      "properties": {
        "format_version": {"const": "1.0"},
        "approval_id": {"type": "string", "minLength": 1},
        "ticket_id": {"type": "string", "minLength": 1},
        "ticket_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "run_id": {"type": "string", "pattern": "^AZPR-RUN-[A-Z0-9]+-[0-9]{8}-[0-9]{4}$"},
        "outcome_id": {"type": "string", "pattern": "^AZPR-OUT-[A-Z0-9]+-[0-9]{8}-[0-9]{4}$"},
        "evidence_id": {"type": "string", "pattern": "^AZPR-EVD-[A-Z0-9]+-[0-9]{8}-[0-9]{4}$"}
      },
      "required": ["format_version", "approval_id", "ticket_id", "ticket_sha256", "run_id", "outcome_id", "evidence_id"]
    },
    "evidence_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "sha256"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 512},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "run": {
      "unevaluatedProperties": false,
      "allOf": [
        {"$ref": "#/$defs/identity"},
        {"type": "object", "required": ["record_kind", "started_at", "base_commit", "branch", "action_ids", "approval_is_execution_result"], "properties": {"record_kind": {"const": "AZPR_EXECUTION_RUN"}, "started_at": {"type": "string", "format": "date-time"}, "base_commit": {"type": "string"}, "branch": {"type": "string"}, "action_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "approval_is_execution_result": {"const": false}}}
      ]
    },
    "evidence": {
      "unevaluatedProperties": false,
      "allOf": [
        {"$ref": "#/$defs/identity"},
        {"type": "object", "required": ["record_kind", "created_at", "evidence_bindings", "contains_raw_authentication_data"], "properties": {"record_kind": {"const": "AZPR_EXECUTION_EVIDENCE_BUNDLE"}, "created_at": {"type": "string", "format": "date-time"}, "evidence_bindings": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence_binding"}}, "contains_raw_authentication_data": {"const": false}}}
      ]
    },
    "outcome": {
      "unevaluatedProperties": false,
      "allOf": [
        {"$ref": "#/$defs/identity"},
        {"type": "object", "required": ["record_kind", "outcome", "completed_at", "action_results", "evidence_bindings", "approval_is_execution_result"], "properties": {"record_kind": {"const": "AZPR_EXECUTION_OUTCOME"}, "outcome": {"enum": ["SUCCEEDED", "FAILED", "STOPPED", "ROLLED_BACK"]}, "completed_at": {"type": "string", "format": "date-time"}, "action_results": {"type": "array", "minItems": 1}, "evidence_bindings": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence_binding"}}, "approval_is_execution_result": {"const": false}}}
      ]
    }
  }
}
