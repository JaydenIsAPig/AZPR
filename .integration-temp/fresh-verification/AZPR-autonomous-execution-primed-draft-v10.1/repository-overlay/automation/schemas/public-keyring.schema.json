{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AZPR Public Keyring (unique signer and key material enforced at runtime)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format_version",
    "keys"
  ],
  "properties": {
    "format_version": {
      "const": "1.0"
    },
    "keys": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key_id",
          "signer_id",
          "roles",
          "public_key_pem",
          "revoked_at"
        ],
        "properties": {
          "key_id": {
            "type": "string",
            "maxLength": 8000
          },
          "signer_id": {
            "type": "string",
            "maxLength": 8000
          },
          "roles": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "maxLength": 8000
            },
            "maxItems": 100
          },
          "public_key_pem": {
            "type": "string",
            "maxLength": 8000
          },
          "revoked_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "maxLength": 8000
          }
        }
      },
      "maxItems": 100
    }
  }
}
