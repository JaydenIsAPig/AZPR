{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://azpr.local/schemas/journal-record.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format_version",
    "sequence",
    "previous_hash",
    "event_type",
    "created_at",
    "run_id",
    "signer_key_id",
    "payload",
    "signature"
  ],
  "properties": {
    "format_version": {
      "const": "1.0"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "previous_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "maxLength": 8000
    },
    "event_type": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8000
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "maxLength": 8000
    },
    "run_id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 8000
    },
    "signer_key_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8000
    },
    "payload": {
      "type": "object",
      "maxProperties": 100
    },
    "signature": {
      "type": "string",
      "minLength": 80,
      "maxLength": 120
    }
  }
}
