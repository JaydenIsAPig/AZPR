{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://azpr.local/schemas/qualification-raw-evidence-v9.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["format_version", "evidence_kind", "report_kind", "challenge_nonce", "host_id",
    "candidate_archive_sha256", "commands", "checks", "transcript_sha256"],
  "properties": {
    "format_version": {"const": "1.0"},
    "evidence_kind": {"const": "AZPR_V9_MACHINE_DERIVABLE_QUALIFICATION_EVIDENCE"},
    "report_kind": {"enum": ["CODEX_ISOLATION_QUALIFICATION", "REMOTE_ANCHOR_QUALIFICATION", "KEY_CUSTODY_QUALIFICATION", "INSTALLER_FAULT_MATRIX_QUALIFICATION", "SUPPLY_CHAIN_REBUILD_QUALIFICATION", "DEDICATED_HOST_POLICY_QUALIFICATION"]},
    "challenge_nonce": {"type": "string", "minLength": 8, "maxLength": 160},
    "host_id": {"type": "string", "minLength": 8, "maxLength": 160},
    "candidate_archive_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "commands": {"type": "array", "minItems": 1, "maxItems": 256, "items": {"type": "object", "additionalProperties": false, "required": ["command_id", "argv_sha256", "tool_sha256", "exit_code", "stdout_sha256", "stderr_sha256"], "properties": {"command_id": {"type": "string", "minLength": 3, "maxLength": 160}, "argv_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "tool_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "exit_code": {"type": "integer", "minimum": 0, "maximum": 255}, "stdout_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "stderr_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}},
    "checks": {"type": "object", "minProperties": 1, "maxProperties": 256, "propertyNames": {"pattern": "^[A-Za-z0-9._:-]{3,160}$"}, "additionalProperties": {"oneOf": [{"type": "boolean"}, {"type": "integer"}, {"type": "string", "maxLength": 4096}, {"type": "array", "maxItems": 128}, {"type": "object", "maxProperties": 128}]}},
    "transcript_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
