{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://azpr.local/schemas/external-runner-installation.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format_version",
    "config_path",
    "config_sha256",
    "schema_dir",
    "schema_hashes",
    "launcher_sha256"
  ],
  "properties": {
    "format_version": {
      "const": "1.0"
    },
    "config_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8000
    },
    "config_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "maxLength": 8000
    },
    "schema_dir": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8000
    },
    "schema_hashes": {
      "type": "object",
      "minProperties": 10,
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$",
        "maxLength": 8000
      },
      "maxProperties": 100
    },
    "launcher_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "maxLength": 8000
    }
  }
}
