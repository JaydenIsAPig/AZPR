{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://azpr.local/schemas/validation-profile.schema.json",
  "title": "AZPR Validation Profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format_version",
    "profile_id",
    "risk_categories",
    "commands",
    "resource_limits",
    "evidence_outputs"
  ],
  "properties": {
    "format_version": {
      "const": "2.0"
    },
    "profile_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,63}$",
      "maxLength": 8000
    },
    "risk_categories": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "format",
          "lint",
          "type",
          "unit",
          "integration",
          "contract",
          "build",
          "browser",
          "accessibility",
          "migration",
          "concurrency",
          "security",
          "privacy",
          "supply-chain",
          "infrastructure",
          "performance",
          "restore",
          "rollback",
          "evidence",
          "documentation"
        ]
      },
      "maxItems": 100
    },
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "category",
          "argv",
          "timeout_seconds"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8000
          },
          "category": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8000
          },
          "argv": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8000
            },
            "maxItems": 100
          },
          "timeout_seconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 7200
          },
          "evidence_files": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8000
            },
            "maxItems": 100
          }
        }
      },
      "maxItems": 100
    },
    "resource_limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cpus",
        "memory_mb",
        "pids",
        "tmpfs_mb",
        "evidence_mb",
        "file_size_mb"
      ],
      "properties": {
        "cpus": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 16
        },
        "memory_mb": {
          "type": "integer",
          "minimum": 128,
          "maximum": 32768
        },
        "pids": {
          "type": "integer",
          "minimum": 16,
          "maximum": 4096
        },
        "tmpfs_mb": {
          "type": "integer",
          "minimum": 16,
          "maximum": 8192
        },
        "evidence_mb": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
        "file_size_mb": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        }
      }
    },
    "evidence_outputs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 8000
      },
      "maxItems": 100
    }
  }
}
