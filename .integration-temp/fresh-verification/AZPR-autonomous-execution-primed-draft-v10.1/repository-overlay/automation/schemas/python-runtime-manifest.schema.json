{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://azpr.local/schemas/python-runtime-manifest.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["format_version", "root", "files", "tree_sha256"],
  "properties": {
    "format_version": {"const": "1.0"},
    "root": {"type": "string", "minLength": 1, "maxLength": 1024},
    "files": {"type": "array", "minItems": 1, "maxItems": 50000, "items": {"type": "object", "additionalProperties": false, "required": ["path", "sha256", "mode"], "properties": {"path": {"type": "string", "minLength": 1, "maxLength": 1024}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$", "maxLength": 64}, "mode": {"type": "string", "pattern": "^[0-7]{3,4}$", "maxLength": 4}}}},
    "tree_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$", "maxLength": 64}
  }
}
