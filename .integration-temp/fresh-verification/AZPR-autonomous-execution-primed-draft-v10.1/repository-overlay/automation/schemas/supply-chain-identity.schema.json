{
  "$id": "https://azpr.local/schemas/supply-chain-identity.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "build_provenance_sha256": {
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "dependency_lock_sha256": {
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "mirror_attestation_sha256": {
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "mirror_inventory_sha256": {
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "mirror_public_key_sha256": {
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "requirements_input_sha256": {
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "sbom_sha256": {
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "validation_dockerfile_sha256": {
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "validation_image_attestation_sha256": {
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "validation_image_digest": {
      "maxLength": 71,
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "wheel_set_sha256": {
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    }
  },
  "required": [
    "build_provenance_sha256",
    "dependency_lock_sha256",
    "mirror_attestation_sha256",
    "mirror_inventory_sha256",
    "mirror_public_key_sha256",
    "requirements_input_sha256",
    "sbom_sha256",
    "validation_dockerfile_sha256",
    "validation_image_attestation_sha256",
    "validation_image_digest",
    "wheel_set_sha256"
  ],
  "type": "object"
}
