        "secret": {
          "const": true
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256",
        "secret"
      ],
      "type": "object"
    }
  },
