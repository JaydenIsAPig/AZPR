      "const": false
    },
    "signature": {
      "maxLength": 88,
      "pattern": "^[A-Za-z0-9+/]{86}==$",
      "type": "string"
    },
    "signer_key_id": {
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9._:-]{8,160}$",
      "type": "string"
    },
    "status": {
      "const": "SEMANTIC_QUALIFICATION_EVIDENCE_VERIFIED_INSTALLATION_STILL_BLOCKED"
    },
    "trusted_pre_autonomous_installation_ready": {
      "const": false
    },
