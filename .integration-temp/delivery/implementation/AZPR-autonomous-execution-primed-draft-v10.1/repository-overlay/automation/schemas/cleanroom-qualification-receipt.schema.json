      "const": "AZPR_V8_SEMANTIC_CLEANROOM_QUALIFICATION_RECEIPT"
    },
    "remaining_closed_gates": {
      "items": {
        "maxLength": 128,
        "type": "string"
      },
      "maxItems": 16,
      "minItems": 7,
      "type": "array",
      "uniqueItems": true
    },
