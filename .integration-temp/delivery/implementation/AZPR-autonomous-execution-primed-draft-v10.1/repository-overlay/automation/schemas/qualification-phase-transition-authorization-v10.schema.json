{
  "$id": "https://azpr.local/schemas/qualification-phase-transition-authorization-v10.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "authorization_kind": {
      "const": "AZPR_V10_QUALIFICATION_TO_POLICY_PHASE_TRANSITION"
    },
    "canonical_policy_record_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "expires_at": {
      "format": "date-time",
      "maxLength": 64,
      "type": "string"
    },
    "fault_matrix_evidence_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "fault_matrix_status": {
      "const": "PASS"
    },
    "format_version": {
      "const": "2.0"
    },
    "host_id": {
      "maxLength": 160,
      "minLength": 8,
      "type": "string"
    },
    "issued_at": {
      "format": "date-time",
      "maxLength": 64,
      "type": "string"
    },
    "nonce": {
      "maxLength": 160,
      "minLength": 8,
      "type": "string"
    },
    "prior_installation_id": {
      "maxLength": 160,
      "minLength": 8,
      "type": "string"
    },
    "prior_installation_receipt_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "prior_lock_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "prior_manifest_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "qualification_artifact_set_version": {
      "const": "2.0"
    },
    "qualification_launcher_evidence_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "qualification_launcher_status": {
      "const": "PASS"
    },
    "qualification_trust_binding_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "sequence": {
      "minimum": 1,
      "type": "integer"
    },
    "signatures": {
      "items": {
        "$ref": "approval.schema.json#/$defs/signature"
      },
      "maxItems": 8,
      "minItems": 2,
      "type": "array"
    },
    "transition_id": {
      "maxLength": 160,
      "pattern": "^phase-transition-[A-Za-z0-9._:-]{8,140}$",
      "type": "string"
    }
  },
  "required": [
    "format_version",
    "authorization_kind",
    "transition_id",
    "sequence",
    "nonce",
    "issued_at",
    "expires_at",
    "host_id",
    "prior_installation_id",
    "prior_manifest_sha256",
    "prior_lock_sha256",
    "prior_installation_receipt_sha256",
    "qualification_launcher_status",
    "qualification_launcher_evidence_sha256",
    "fault_matrix_status",
    "fault_matrix_evidence_sha256",
    "canonical_policy_record_sha256",
    "signatures",
    "qualification_artifact_set_version",
    "qualification_trust_binding_sha256"
  ],
  "type": "object"
}
