{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://azpr.local/schemas/dependency-mirror-inventory.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["format_version", "mirror_name", "inventory_sha256", "file_count", "total_bytes", "files"],
  "properties": {
    "format_version": {"const": "1.0"},
    "mirror_name": {"type": "string", "minLength": 1, "maxLength": 255},
    "inventory_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "file_count": {"type": "integer", "minimum": 1, "maximum": 10000},
    "total_bytes": {"type": "integer", "minimum": 1, "maximum": 5000000000},
    "files": {
      "type": "array", "minItems": 1, "maxItems": 10000,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["path", "sha256", "size"],
        "properties": {
          "path": {"type": "string", "minLength": 1, "maxLength": 1024},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "size": {"type": "integer", "minimum": 1, "maximum": 1000000000}
        }
      }
    }
  }
}
