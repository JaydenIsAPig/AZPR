{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://azpr.local/schemas/approval.schema.json",
  "title": "AZPR Ed25519 Approval",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format_version",
    "approval_id",
    "approved",
    "stage_id",
    "target_commit",
    "controller_version",
    "environment",
    "approved_actions",
    "issued_at",
    "expires_at",
    "nonce",
    "bindings",
    "decision",
    "signatures"
  ],
  "properties": {
    "format_version": {
      "const": "2.0"
    },
    "approval_id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 8000
    },
    "approved": {
      "const": true
    },
    "stage_id": {
      "type": "string",
      "pattern": "^(?:[0-9]{3}|[ABC])$",
      "maxLength": 8000
    },
    "target_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$",
      "maxLength": 8000
    },
    "controller_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8000
    },
    "environment": {
      "enum": [
        "local",
        "test",
        "staging",
        "production"
      ]
    },
    "approved_actions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 8000
      },
      "maxItems": 100
    },
    "issued_at": {
      "type": "string",
      "format": "date-time",
      "maxLength": 8000
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "maxLength": 8000
    },
    "nonce": {
      "type": "string",
      "minLength": 24,
      "maxLength": 8000
    },
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_hashes",
        "plan_sha256",
        "capability_manifest_sha256",
        "target_attestation_sha256"
      ],
      "properties": {
        "policy_hashes": {
          "type": "object",
          "minProperties": 8,
          "additionalProperties": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "maxLength": 8000
          },
          "maxProperties": 100
        },
        "plan_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$",
          "maxLength": 8000
        },
        "capability_manifest_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$",
          "maxLength": 8000
        },
        "target_attestation_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$",
          "maxLength": 8000
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "account_id",
        "project_id",
        "region",
        "resources",
        "database_targets",
        "network_destinations",
        "recipient_cohort",
        "limits",
        "activation_window",
        "backup_rollback",
        "evidence_outputs"
      ],
      "properties": {
        "account_id": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 8000
        },
        "project_id": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 8000
        },
        "region": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 8000
        },
        "resources": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 8000
          },
          "maxItems": 100
        },
        "database_targets": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 8000
          },
          "maxItems": 100
        },
        "network_destinations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "host",
              "methods"
            ],
            "properties": {
              "host": {
                "type": "string",
                "maxLength": 8000
              },
              "methods": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "GET",
                    "HEAD",
                    "POST",
                    "PUT",
                    "PATCH",
                    "DELETE"
                  ]
                },
                "maxItems": 100
              }
            }
          },
          "maxItems": 100
        },
        "recipient_cohort": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "cohort_id",
            "recipient_count",
            "recipient_hash"
          ],
          "properties": {
            "cohort_id": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 8000
            },
            "recipient_count": {
              "type": "integer",
              "minimum": 0
            },
            "recipient_hash": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[0-9a-f]{64}$",
              "maxLength": 8000
            }
          }
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "cost_ceiling_usd",
            "rate_per_minute",
            "max_operations"
          ],
          "properties": {
            "cost_ceiling_usd": {
              "type": "number",
              "minimum": 0
            },
            "rate_per_minute": {
              "type": "integer",
              "minimum": 0
            },
            "max_operations": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "activation_window": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "starts_at",
            "ends_at"
          ],
          "properties": {
            "starts_at": {
              "type": [
                "string",
                "null"
              ],
              "format": "date-time",
              "maxLength": 8000
            },
            "ends_at": {
              "type": [
                "string",
                "null"
              ],
              "format": "date-time",
              "maxLength": 8000
            }
          }
        },
        "backup_rollback": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "backup_id",
            "rollback_plan_sha256",
            "kill_switch"
          ],
          "properties": {
            "backup_id": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 8000
            },
            "rollback_plan_sha256": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[0-9a-f]{64}$",
              "maxLength": 8000
            },
            "kill_switch": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 8000
            }
          }
        },
        "evidence_outputs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 8000
          },
          "maxItems": 100
        }
      }
    },
    "signatures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key_id",
          "ed25519"
        ],
        "properties": {
          "key_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8000
          },
          "ed25519": {
            "type": "string",
            "minLength": 80,
            "maxLength": 120
          }
        }
      },
      "maxItems": 100
    }
  },
  "$defs": {
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "account_id",
        "project_id",
        "region",
        "resources",
        "database_targets",
        "network_destinations",
        "recipient_cohort",
        "limits",
        "activation_window",
        "backup_rollback",
        "evidence_outputs"
      ],
      "properties": {
        "account_id": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 8000
        },
        "project_id": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 8000
        },
        "region": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 8000
        },
        "resources": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 8000
          },
          "maxItems": 100
        },
        "database_targets": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 8000
          },
          "maxItems": 100
        },
        "network_destinations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "host",
              "methods"
            ],
            "properties": {
              "host": {
                "type": "string",
                "maxLength": 8000
              },
              "methods": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "GET",
                    "HEAD",
                    "POST",
                    "PUT",
                    "PATCH",
                    "DELETE"
                  ]
                },
                "maxItems": 100
              }
            }
          },
          "maxItems": 100
        },
        "recipient_cohort": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "cohort_id",
            "recipient_count",
            "recipient_hash"
          ],
          "properties": {
            "cohort_id": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 8000
            },
            "recipient_count": {
              "type": "integer",
              "minimum": 0
            },
            "recipient_hash": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[0-9a-f]{64}$",
              "maxLength": 8000
            }
          }
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "cost_ceiling_usd",
            "rate_per_minute",
            "max_operations"
          ],
          "properties": {
            "cost_ceiling_usd": {
              "type": "number",
              "minimum": 0
            },
            "rate_per_minute": {
              "type": "integer",
              "minimum": 0
            },
            "max_operations": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "activation_window": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "starts_at",
            "ends_at"
          ],
          "properties": {
            "starts_at": {
              "type": [
                "string",
                "null"
              ],
              "format": "date-time",
              "maxLength": 8000
            },
            "ends_at": {
              "type": [
                "string",
                "null"
              ],
              "format": "date-time",
              "maxLength": 8000
            }
          }
        },
        "backup_rollback": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "backup_id",
            "rollback_plan_sha256",
            "kill_switch"
          ],
          "properties": {
            "backup_id": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 8000
            },
            "rollback_plan_sha256": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[0-9a-f]{64}$",
              "maxLength": 8000
            },
            "kill_switch": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 8000
            }
          }
        },
        "evidence_outputs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 8000
          },
          "maxItems": 100
        }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key_id",
        "ed25519"
      ],
      "properties": {
        "key_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "ed25519": {
          "type": "string",
          "minLength": 80,
          "maxLength": 120,
          "pattern": "^[A-Za-z0-9+/]+={0,2}$"
        }
      }
    }
  }
}
