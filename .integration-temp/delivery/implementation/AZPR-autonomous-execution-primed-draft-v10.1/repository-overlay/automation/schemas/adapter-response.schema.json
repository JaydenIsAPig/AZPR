{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://azpr.local/schemas/adapter-response.schema.json",
  "type": "object",
  "additionalProperties": true,
  "maxProperties": 100,
  "properties": {
    "target": {
      "$ref": "capability-manifest.schema.json#/properties/target"
    },
    "drift_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "maxLength": 8000
    },
    "safe_to_apply": {
      "type": "boolean"
    },
    "status": {
      "enum": [
        "APPLIED",
        "NO_CHANGE",
        "FAILED",
        "ROLLED_BACK"
      ]
    }
  }
}
