{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://azpr.local/schemas/host-bootstrap-roots-v9.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["format_version", "bootstrap_kind", "manifest_id", "sequence", "issued_at", "roots", "signer_key_id", "signature"],
  "properties": {
    "format_version": {"const": "1.0"}, "bootstrap_kind": {"const": "AZPR_V9_HOST_BOOTSTRAP_ROOTS"},
    "manifest_id": {"type": "string", "minLength": 8, "maxLength": 160}, "sequence": {"type": "integer", "minimum": 1},
    "issued_at": {"type": "string", "format": "date-time", "maxLength": 64},
    "roots": {"type": "object", "additionalProperties": false, "required": ["qualification_authorization_keyring_sha256", "qualification_receipt_signing_public_key_sha256", "phase_transition_keyring_sha256", "authorization_anchor_identity_sha256"], "properties": {
      "qualification_authorization_keyring_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
      "qualification_receipt_signing_public_key_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
      "phase_transition_keyring_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
      "authorization_anchor_identity_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
    }},
    "signer_key_id": {"type": "string", "minLength": 8, "maxLength": 160},
    "signature": {"type": "string", "pattern": "^[A-Za-z0-9+/]{86}==$"}
  }
}
