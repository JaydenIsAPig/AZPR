{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://azpr.local/schemas/capability-manifest.schema.json",
  "title": "AZPR External Capability Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format_version",
    "manifest_id",
    "plan_sha256",
    "target_attestation_sha256",
    "environment",
    "target",
    "actions",
    "constraints",
    "nonce",
    "issued_at",
    "expires_at",
    "signatures",
    "operation_registration_id",
    "stage_id",
    "source_commit",
    "source_tree",
    "target_sha256",
    "operations_sha256",
    "controller_policy_identity_sha256"
  ],
  "properties": {
    "format_version": {
      "const": "1.0"
    },
    "manifest_id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 8000
    },
    "plan_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "maxLength": 8000
    },
    "environment": {
      "enum": [
        "staging",
        "production"
      ]
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "account_id",
        "project_id",
        "region",
        "resources"
      ],
      "properties": {
        "account_id": {
          "type": "string",
          "maxLength": 8000
        },
        "project_id": {
          "type": "string",
          "maxLength": 8000
        },
        "region": {
          "type": "string",
          "maxLength": 8000
        },
        "resources": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 8000
          },
          "maxItems": 100
        }
      }
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "adapter",
          "operation",
          "parameters_sha256"
        ],
        "properties": {
          "adapter": {
            "type": "string",
            "maxLength": 8000
          },
          "operation": {
            "type": "string",
            "maxLength": 8000
          },
          "parameters_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "maxLength": 8000
          }
        }
      },
      "maxItems": 100
    },
    "constraints": {
      "$ref": "approval.schema.json#/$defs/decision"
    },
    "nonce": {
      "type": "string",
      "minLength": 24,
      "maxLength": 200
    },
    "issued_at": {
      "type": "string",
      "format": "date-time",
      "maxLength": 8000
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "maxLength": 8000
    },
    "signatures": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key_id",
          "ed25519"
        ],
        "properties": {
          "key_id": {
            "type": "string",
            "maxLength": 8000
          },
          "ed25519": {
            "type": "string",
            "maxLength": 8000
          }
        }
      },
      "maxItems": 10
    },
    "target_attestation_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "maxLength": 8000
    },
    "operation_registration_id": {
      "type": "string",
      "minLength": 16,
      "maxLength": 160
    },
    "stage_id": {
      "type": "string",
      "pattern": "^(?:[0-9]{3}|[ABC])$",
      "maxLength": 3
    },
    "source_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$",
      "maxLength": 40
    },
    "source_tree": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$",
      "maxLength": 40
    },
    "target_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "maxLength": 64
    },
    "operations_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "maxLength": 64
    },
    "controller_policy_identity_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "maxLength": 64
    }
  }
}
