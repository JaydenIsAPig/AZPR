{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://azpr.local/schemas/dependency-mirror-attestation.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["format_version", "mirror_name", "inventory_sha256", "file_count", "total_bytes", "created_at", "signer_key_id", "signature"],
  "properties": {
    "format_version": {"const": "1.0"},
    "mirror_name": {"type": "string", "minLength": 1, "maxLength": 255},
    "inventory_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$", "maxLength": 64},
    "file_count": {"type": "integer", "minimum": 1, "maximum": 10000},
    "total_bytes": {"type": "integer", "minimum": 1, "maximum": 5000000000},
    "created_at": {"type": "string", "format": "date-time", "maxLength": 64},
    "signer_key_id": {"type": "string", "minLength": 1, "maxLength": 160},
    "signature": {"type": "string", "minLength": 80, "maxLength": 120}
  }
}
